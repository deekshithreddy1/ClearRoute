{
  "name": "clearroute",
  "private": true,
  "overrides": {
    "shell-quote": "1.11.0"
  },
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "localnet:setup": "node dist-backend/setup-localnet.js",
    "wallet:setup": "node dist-backend/setup-wallets.js",
    "wallet:e2e": "node scripts/verify-wallet-funding.mjs",
    "gas:e2e": "node scripts/verify-gas-station.mjs",
    "dev": "concurrently -k -n api,web \"tsx watch backend/index.ts\" \"vite\"",
    "build": "node scripts/build.mjs",
    "start": "node dist-backend/index.js",
    "auth:admin": "node dist-backend/auth-admin.js",
    "hackathon:e2e": "node scripts/hackathon-e2e.mjs",
    "test": "npm run test:backend && npm run test:frontend",
    "typecheck": "tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test:backend": "node scripts/test-backend.mjs",
    "test:frontend": "vitest run",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.11"
  }
}
