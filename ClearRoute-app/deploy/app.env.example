CLEARROUTE_DOMAIN=clearroute.example.com
CLEARROUTE_PUBLIC_ORIGIN=https://clearroute.example.com
CLEARROUTE_MODE=hosted
CLEARROUTE_AUTH_MODE=required
CLEARROUTE_NETWORK_MODE=devnet
CLEARROUTE_DEVNET_PROVIDER_TOKEN=REPLACE_IN_PRIVATE_ENV_FILE
CLEARROUTE_DEVNET_CUSTOMER_TOKEN=REPLACE_WITH_SEPARATELY_SCOPED_TOKEN

# Optional Devnet-only public funding pilot. See DEVNET-PILOT.md.
CLEARROUTE_PUBLIC_FUNDING=0
CLEARROUTE_DEVNET_TREASURY_PARTY=
CLEARROUTE_DEVNET_WALLET_TOKEN=
# Set to ENABLED only after checking the treasury and recipient compatibility.
CLEARROUTE_DEVNET_TRANSFERS=DISABLED

# Renewable NODERS authentication (preferred for a long-running deployment).
# Leave blank for the initial manual-token pilot. To enable renewal, use
# compose.oidc.yaml and config/oidc.json as described in DEPLOYMENT.md.
CLEARROUTE_OIDC_CONFIG_FILE=
# Generate once with a cryptographically secure tool; never commit this value.
CLEARROUTE_TOKEN_STORE_KEY=
CLEARROUTE_NODERS_REFRESH_TOKEN=
